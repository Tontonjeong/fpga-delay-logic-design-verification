# Board-independent Quartus project for the portfolio baseline.
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5ED065BB32AE6SR0
set_global_assignment -name TOP_LEVEL_ENTITY delay_logic
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/delay_logic.sv
set_global_assignment -name SDC_FILE ../constraints/delay_logic.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_MODE "BALANCED"

# No physical board is selected; all top-level ports use virtual pins.
set_instance_assignment -name VIRTUAL_PIN ON -to iClk
set_instance_assignment -name VIRTUAL_PIN ON -to iRsn
set_instance_assignment -name VIRTUAL_PIN ON -to iDataEn
set_instance_assignment -name VIRTUAL_PIN ON -to "iData[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "iDelay[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to oDataEn
set_instance_assignment -name VIRTUAL_PIN ON -to "oData[*]"
